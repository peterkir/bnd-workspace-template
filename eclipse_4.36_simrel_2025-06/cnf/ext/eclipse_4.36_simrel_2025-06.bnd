# Eclipse Simultaneous Release repository 
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.36      = 4.36
eclipse.simrel.version.2025-06     = 2025-06
eclipse.simrel.reltag.202506111000 = 202506111000

eclipse.p2.repository.2025-06: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 SimRel ${eclipse.platform.version.4.36}/${eclipse.simrel.version.2025-06}'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2025-06}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.36}_simrel_${eclipse.simrel.version.2025-06}_p2.index.xml.gz'

eclipse.osgi.repository.2025-06: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.36}/${eclipse.simrel.version.2025-06}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.36}_simrel_${eclipse.simrel.version.2025-06}_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.36}'

-plugin.p2.eclipse.simrel_2025-06: ${if;${useIndexed};;${eclipse.p2.repository.2025-06}}
-plugin.osgi.eclipse.simrel_2025-06: ${if;${useIndexed};${eclipse.osgi.repository.2025-06};}
