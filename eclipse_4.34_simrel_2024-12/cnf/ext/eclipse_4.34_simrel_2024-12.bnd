# Eclipse Simultaneous Release repository 
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.34      = 4.34
eclipse.simrel.version.2024-12     = 2024-12
eclipse.simrel.reltag.202412041000 = 202412041000

eclipse.p2.repository.2024-12: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 SimRel ${eclipse.platform.version.4.34}/${eclipse.simrel.version.2024-12}'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2024-12}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.34}_simrel_${eclipse.simrel.version.2024-12}_p2.index.xml.gz'

eclipse.osgi.repository.2024-12: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.34}/${eclipse.simrel.version.2024-12}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.34}_simrel_${eclipse.simrel.version.2024-12}_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.34}'

-plugin.p2.eclipse.simrel_2024-12: ${if;${useIndexed};;${eclipse.p2.repository.2024-12}}
-plugin.osgi.eclipse.simrel_2024-12: ${if;${useIndexed};${eclipse.osgi.repository.2024-12};}
