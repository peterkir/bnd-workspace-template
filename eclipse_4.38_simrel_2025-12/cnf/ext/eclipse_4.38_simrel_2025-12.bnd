# Eclipse Simultaneous Release repository 
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.38      = 4.38
eclipse.simrel.version.2025-12     = 2025-12
eclipse.simrel.reltag.202512101000 = 202512101000

eclipse.p2.repository.2025-12: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 SimRel ${eclipse.platform.version.4.38}/${eclipse.simrel.version.2025-12}'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2025-12}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.38}_simrel_${eclipse.simrel.version.2025-12}_p2.index.xml.gz'

eclipse.osgi.repository.2025-12: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.38}/${eclipse.simrel.version.2025-12}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.38}_simrel_${eclipse.simrel.version.2025-12}_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.38}'

-plugin.p2.eclipse.simrel_2025-12: ${if;${useIndexed};;${eclipse.p2.repository.2025-12}}
-plugin.osgi.eclipse.simrel_2025-12: ${if;${useIndexed};${eclipse.osgi.repository.2025-12};}
