# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.39 = 4.39
eclipse.platform.reltag.R-4.39-202602260420 = R-4.39-202602260420

eclipse.p2.repository.4.39: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 Platform ${eclipse.platform.version.4.39}'; \
        url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.39}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.39}_platform_p2.index.xml.gz'

eclipse.osgi.repository.4.39: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse Platform ${eclipse.platform.version.4.39}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.39}_platform_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.39}'

-plugin.p2.eclipse.platform_4.39: ${if;${useIndexed};;${eclipse.p2.repository.4.39}}
-plugin.osgi.eclipse.platform_4.39: ${if;${useIndexed};${eclipse.osgi.repository.4.39};}
