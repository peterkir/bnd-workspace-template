# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.33 = 4.33
eclipse.platform.reltag.R-4.33-202409030240 = R-4.33-202409030240

eclipse.p2.repository.4.33: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 Platform ${eclipse.platform.version.4.33}'; \
        url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.33}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.33}_platform_p2.index.xml.gz'

eclipse.osgi.repository.4.33: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse Platform ${eclipse.platform.version.4.33}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.33}_platform_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.33}'

-plugin.p2.eclipse.platform_4.33: ${if;${useIndexed};;${eclipse.p2.repository.4.33}}
-plugin.osgi.eclipse.platform_4.33: ${if;${useIndexed};${eclipse.osgi.repository.4.33};}
